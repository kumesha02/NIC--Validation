NODE_ENV=development

# Shared secrets
JWT_SECRET=supersecretjwt

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nic_validation_db

# Email (Auth service)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=user@example.com
EMAIL_PASS=password
EMAIL_FROM="NIC Validation <noreply@example.com>"

# Frontend URL for reset emails
FRONTEND_URL=http://localhost:3000

# Service URLs (used when running without docker-compose)
AUTH_SERVICE_URL=http://localhost:8081
NIC_VALIDATION_SERVICE_URL=http://localhost:8082
FILE_PROCESSING_SERVICE_URL=http://localhost:8083
DASHBOARD_SERVICE_URL=http://localhost:8084
REPORT_SERVICE_URL=http://localhost:8085
